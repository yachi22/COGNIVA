# ==============================================================================
# Cogniva Backend Environment Configuration Example
# Copy this file to .env and provide your secrets/database credentials.
# ==============================================================================

# Application & Environment
PROJECT_NAME="Cogniva"
ENVIRONMENT="production"         # Set to "production" in live deployment or "development" locally
DEBUG=false                     # Enforced false in production mode
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (Comma-separated URLs or JSON array)
# Allowed origins for frontend clients (e.g. Vercel deployment)
CORS_ORIGINS="https://cogniva-gules.vercel.app,http://localhost:5173,http://localhost:3000"

# Database Configuration (PostgreSQL 15+ with pgvector extension)
# For Render / Supabase / Neon: postgresql+asyncpg://user:pass@host:5432/dbname?ssl=require
DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/cogniva"

# Security & Authentication (JWT)
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
# Must NOT use the default placeholder in production mode!
SECRET_KEY="replace-with-a-secure-random-64-character-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage & Document Limits
# Provider options: "local", "s3", or "r2" (compatible with Amazon S3, Cloudflare R2, MinIO)
STORAGE_PROVIDER="local"
STORAGE_DIR="storage"
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf", "docx", "csv"]

# Durable Object Storage Configuration (Required if STORAGE_PROVIDER is "s3" or "r2")
# AWS S3: S3_REGION_NAME="us-east-1", S3_ENDPOINT_URL=""
# Cloudflare R2: S3_REGION_NAME="auto", S3_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
S3_BUCKET_NAME="cogniva-documents"
S3_ENDPOINT_URL=""
S3_REGION_NAME="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_SIGNED_URL_EXPIRATION_SECONDS=900
S3_PREFIX="cogniva"

# Deterministic Document Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_CHUNK_SIZE=50

# Semantic Retrieval & Vector Embeddings
# Providers: "openai" or "mock" (for deterministic local testing)
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
MAX_RETRIEVAL_TOP_K=20

# OpenAI API Key (required when EMBEDDING_PROVIDER="openai" or using OpenAI LLM)
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
# Optional custom base URL for Azure OpenAI or OpenAI-compatible proxies
# OPENAI_BASE_URL="https://api.openai.com/v1"

# LLM Synthesis & RAG Generation
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
