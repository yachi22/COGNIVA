# ==============================================================================
# Cogniva Enterprise Environment Configuration Template
# ==============================================================================

# Application Metadata
PROJECT_NAME="Cogniva"
VERSION="0.1.0"
ENVIRONMENT="development"               # Use "production" for production deployment
DEBUG=True                              # Automatically forced to False in production

# Backend Server
HOST="0.0.0.0"
PORT=8000                               # Automatically overridden by $PORT on cloud container hosts
API_V1_STR="/api/v1"

# CORS Configuration
# Accepts JSON array or comma-separated string of allowed frontend origins
# In production: CORS_ORIGINS=["https://cogniva.vercel.app"]
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Frontend Configuration
# In production on Vercel, set to your deployed backend URL:
# Example: VITE_API_BASE_URL="https://cogniva-backend.onrender.com/api/v1"
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Database Configuration (PostgreSQL with pgvector)
# Local development default:
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="cogniva"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/cogniva"

# Cloud Managed PostgreSQL with pgvector (e.g. Supabase, Neon, or Railway):
# Example: DATABASE_URL="postgresql://postgres.xxx:mypassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Authentication & Security
# In production, generate a secure random 32-byte key: openssl rand -hex 32
SECRET_KEY="cogniva-super-secret-key-for-development-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440        # 24 hours

# Document Storage & Uploads
STORAGE_DIR="storage"                   # Or mounted persistent volume path, e.g. /data/storage
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf", "docx"]

# Chunking & Embeddings Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_PROVIDER="openai"             # "openai" for production; "mock" for local/offline testing
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# Semantic Retrieval & RAG
DEFAULT_RETRIEVAL_TOP_K=5
MAX_RETRIEVAL_TOP_K=20

# LLM & RAG Answer Generation
LLM_PROVIDER="openai"                   # "openai" for production; "mock" for local/offline testing
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1000
MAX_CONTEXT_CHARS=8000

# OpenAI API Key (Required for live embedding generation and LLM answering)
OPENAI_API_KEY="your-openai-api-key-here"
