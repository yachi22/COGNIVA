# ==============================================================================
# Cogniva Frontend Environment Configuration Example
# Copy this file to .env.local for local frontend development.
# ==============================================================================

# Backend API Base URL
# Local development proxy: /api/v1 (vite.config.ts proxies to http://localhost:8000)
# Production deployment: https://cogniva-api.onrender.com/api/v1
VITE_API_BASE_URL="https://cogniva-api.onrender.com/api/v1"
